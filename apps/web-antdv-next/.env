# 应用标题
VITE_APP_TITLE=Vben Admin Antdv Next

# 应用命名空间，用于缓存、store等功能的前缀，确保隔离
VITE_APP_NAMESPACE=vben-web-antdv-next

# 对store进行加密的密钥，在将store持久化到localStorage时会使用该密钥进行加密
VITE_APP_STORE_SECURE_KEY=please-replace-me-with-your-own-key

# API 业务服务器配置
VITE_GLOB_API_URL=/api
VITE_API_BASE_URL=http://10.0.5.20:8044

# OpenIddict 认证服务器配置
VITE_GLOB_AUTH_URL=/auth-server
VITE_AUTH_BASE_URL=http://10.0.5.20:8043
VITE_AUTH_TOKEN_PATH=/connect/token
VITE_AUTH_USER_INFO_PATH=/connect/userinfo
VITE_AUTH_CLIENT_ID=IM_Mobile
VITE_AUTH_CLIENT_SECRET=1q2w3e*
VITE_AUTH_SCOPE=IM offline_access roles profile phone email address
VITE_AUTH_LOGIN_GRANT_TYPE=password

# SignalR Hubs 通用配置
VITE_SIGNALR_BASE_URL=http://10.0.5.20:8044
VITE_SIGNALR_HUB_PATH=/signalr-hubs/chat
VITE_SIGNALR_SKIP_NEGOTIATION=true
VITE_SIGNALR_RECONNECT_DELAYS_MS=0,2000,10000,30000

# 扫码登录专用配置
VITE_SCAN_LOGIN_SIGNALR_BASE_URL=http://10.0.5.20:8044
VITE_SCAN_LOGIN_HUB_PATH=/signalr-hubs/scan-login
VITE_SCAN_LOGIN_TEMPLATE=gotoim://scan-login?code={code}
VITE_SCAN_LOGIN_QR_EXPIRES_SECONDS=90
VITE_SCAN_LOGIN_AUTH_BASE_URL=http://10.0.5.20:8043
VITE_SCAN_LOGIN_AUTH_TOKEN_PATH=/connect/token
VITE_SCAN_LOGIN_AUTH_CLIENT_ID=IM_Mobile
VITE_SCAN_LOGIN_AUTH_CLIENT_SECRET=1q2w3e*
VITE_SCAN_LOGIN_AUTH_SCOPE=IM

