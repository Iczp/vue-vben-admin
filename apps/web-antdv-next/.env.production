VITE_BASE=/

# 接口地址
VITE_GLOB_API_URL=/api
VITE_GLOB_AUTH_URL=/auth-server
VITE_CMS_WEB_URL=/

# 部署时由 Caddy 提供同源 API、认证和 SignalR 入口。
VITE_SIGNALR_BASE_URL=/
VITE_SCAN_LOGIN_SIGNALR_BASE_URL=/
VITE_SCAN_LOGIN_AUTH_BASE_URL=/auth-server
VITE_NITRO_MOCK=false

# 是否开启压缩，可以设置为 none, brotli, gzip
VITE_COMPRESS=none

# 是否开启 PWA
VITE_PWA=false

# vue-router 的模式
VITE_ROUTER_HISTORY=hash

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true

# 打包后是否生成dist.zip
VITE_ARCHIVER=true
