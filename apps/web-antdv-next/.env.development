# 端口号
VITE_PORT=5999

VITE_BASE=/

# 业务 API 接口前缀
VITE_GLOB_API_URL=/api
VITE_API_BASE_URL=http://10.0.5.20:8044

# OpenIddict 认证服务器前缀
VITE_GLOB_AUTH_URL=/auth-server
VITE_AUTH_BASE_URL=http://10.0.5.20:8043
VITE_AUTH_TOKEN_PATH=/connect/token
VITE_AUTH_USER_INFO_PATH=/connect/userinfo
VITE_AUTH_CLIENT_ID=IM_Mobile
VITE_AUTH_CLIENT_SECRET=1q2w3e*
VITE_AUTH_SCOPE=IM offline_access roles profile phone email address
VITE_AUTH_LOGIN_GRANT_TYPE=password

# SignalR Hubs 配置
VITE_SIGNALR_BASE_URL=http://10.0.5.20:8044
VITE_SIGNALR_HUB_PATH=/signalr-hubs/chat

# 是否开启 Nitro Mock服务，true 为开启，false 为关闭
VITE_NITRO_MOCK=false

# 是否打开 devtools，true 为打开，false 为关闭
VITE_DEVTOOLS=false

# 是否注入全局loading
VITE_INJECT_APP_LOADING=true
