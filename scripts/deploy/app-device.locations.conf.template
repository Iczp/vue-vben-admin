# Render only APP_DEVICE_API_UPSTREAM with envsubst and include INSIDE the frontend server block.
# The upstream must be reachable by the frontend proxy; configure its value in the deployment environment.
location = /api/app-device/abp/application-configuration {
    proxy_pass ${APP_DEVICE_API_UPSTREAM}/api/abp/application-configuration$is_args$args;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
location /api/app-device/ {
    proxy_pass ${APP_DEVICE_API_UPSTREAM};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
